{
  "name": "night-out",
  "version": "2.0.0",
  "private": true,
  "description": "Pick a few bars, send the link, and let your friends vote on where you're going tonight.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4187 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:e2e": "playwright test",
    "icons": "node scripts/render-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeKarlsson/night-out.git"
  },
  "author": "Joe Karlsson",
  "license": "ISC",
  "homepage": "https://night-out.joekarlsson.com/",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "vite": "8.3.6"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0"
  }
}
